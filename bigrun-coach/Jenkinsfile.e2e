pipeline {
    agent any
    tools { maven 'Maven 3.9' }

    environment {
        // Playwright w trybie zdalnym — przeglądarki są w kontenerze pw-server, nie w Jenkinsie
        PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = '1'
    }

    stages {
        stage('Stack Start') {
            steps {
                dir('bigrun-coach') {
                    withCredentials([
                        string(credentialsId: 'db-name', variable: 'DB_NAME'),
                        string(credentialsId: 'db-username', variable: 'DB_USERNAME'),
                        string(credentialsId: 'db-password', variable: 'DB_PASSWORD'),
                        string(credentialsId: 'ollama-base-url', variable: 'OLLAMA_BASE_URL')
                    ]) {
                        sh '''
                            cat <<EOF > .env
DB_NAME=${DB_NAME}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}
OLLAMA_BASE_URL=${OLLAMA_BASE_URL}
EOF
                            docker-compose down
                            docker-compose up -d --build
                        '''
                    }
                    sh 'sleep 20'
                }
            }
        }
        stage('E2E Grid Start') {
            steps {
                dir('bigrun-coach-se') {
                    sh 'docker-compose up -d'
                    sh 'sleep 10'
                }
            }
        }
        // catchError — czerwone testy Selenium oznaczają build jako FAILURE, ale nie zatrzymują stage'y Playwright
        stage('E2E Tests') {
            parallel {
                stage('E2E Chrome') {
                    steps {
                        dir('bigrun-coach-se') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                sh 'mvn test -Dbrowser=chrome -Dgrid.url=http://host.docker.internal:4444 -Dbase.url=http://host.docker.internal:80'
                            }
                        }
                    }
                }
                stage('E2E Firefox') {
                    steps {
                        dir('bigrun-coach-se') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                sh 'mvn test -Dbrowser=firefox -Dgrid.url=http://host.docker.internal:4444 -Dbase.url=http://host.docker.internal:80'
                            }
                        }
                    }
                }
            }
        }
        stage('PW Server Start') {
            steps {
                dir('bigrun-coach-pw') {
                    sh 'docker-compose up -d'
                    // czekamy na gotowość serwera zamiast stałego sleep (npx pobiera pakiet przy starcie)
                    sh 'timeout 90 sh -c "until docker logs pw-server 2>&1 | grep -q \\"Listening on\\"; do sleep 2; done"'
                }
            }
        }
        // kompilacja raz — równoległe stage'e nie kompilują jednocześnie do tego samego target/
        stage('PW Build') {
            steps {
                dir('bigrun-coach-pw') {
                    sh 'mvn -q test-compile'
                }
            }
        }
        // na wzór Selenium — pełny zestaw na każdej przeglądarce, równolegle
        stage('PW Tests') {
            parallel {
                stage('PW Chromium') {
                    steps {
                        dir('bigrun-coach-pw') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                sh 'mvn test -Dbrowser=chromium -Dpw.ws.url=ws://host.docker.internal:3000/ -Dbase.url=http://host.docker.internal:80'
                            }
                        }
                    }
                }
                stage('PW Firefox') {
                    steps {przed
                        dir('bigrun-coach-pw') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                sh 'mvn test -Dbrowser=firefox -Dpw.ws.url=ws://host.docker.internal:3000/ -Dbase.url=http://host.docker.internal:80'
                            }
                        }
                    }
                }
                stage('PW WebKit') {
                    steps {
                        dir('bigrun-coach-pw') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                sh 'mvn test -Dbrowser=webkit -Dpw.ws.url=ws://host.docker.internal:3000/ -Dbase.url=http://host.docker.internal:80'
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            junit testResults: 'bigrun-coach-se/target/surefire-reports/*.xml', allowEmptyResults: true
            junit testResults: 'bigrun-coach-pw/target/surefire-reports/**/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'bigrun-coach-pw/target/traces/**', allowEmptyArchive: true
            // jeden wspólny raport Allure: Selenium + Playwright (3 przeglądarki)
            allure includeProperties: false, results: [
                [path: 'bigrun-coach-se/target/allure-results'],
                [path: 'bigrun-coach-pw/target/allure-results/chromium'],
                [path: 'bigrun-coach-pw/target/allure-results/firefox'],
                [path: 'bigrun-coach-pw/target/allure-results/webkit']
            ]
            dir('bigrun-coach-pw') {
                sh 'docker-compose down'
            }
            dir('bigrun-coach-se') {
                sh 'docker-compose down'
            }
            dir('bigrun-coach') {
                sh 'docker-compose down'
                sh 'rm -f .env'
            }
        }
        failure {
            echo 'E2E pipeline failed — check logs'
        }
    }
}
