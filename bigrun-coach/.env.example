# ==============================
# PROFILE - dev, prod
# ==============================
SPRING_PROFILES_ACTIVE=dev

# ==============================
# DB - remove placeholders and set you own values
# ==============================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bigrun-coach
# --- DB_OPTIONS ---
# Leave empty for local dev.
# Use eg. ?sslmode=require for cloud envs.
DB_OPTIONS=
DB_USERNAME=
DB_PASSWORD=

# ==============================
# AI PROVIDER - set AI_PROVIDER to exactly one of: ollama | google-genai | openai
# ==============================

# --- Option 1: Gemini (default) — free, no GPU needed, just an API key from aistudio.google.com ---
AI_PROVIDER=google-genai
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Option 2: Ollama local LLM — requires `ollama serve` running locally ---
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_SMART_MODEL=qwen2.5:14b
# OLLAMA_FAST_MODEL=llama3.2:3b
# OLLAMA_BIELIK_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Option 3: OpenAI - paid - see https://platform.openai.com ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small