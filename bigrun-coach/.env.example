# ==============================
# PROFILE - dev, prod
# ==============================
SPRING_PROFILES_ACTIVE=dev

# ==============================
# DB - remove placeholders and set you own values
# ==============================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bigrun-coach
# --- DB_OPTIONS ---
# Leave empty for local dev.
# Use eg. ?sslmode=require for cloud envs.
DB_OPTIONS=
DB_USERNAME=
DB_PASSWORD=

# ==============================
# AI PROVIDER - choose and uncomment one block
# ==============================

# --- Option 1: Ollama local LLM (default) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMART_MODEL=qwen2.5:14b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Option 2: Gemini — free ---
# OLLAMA_ENABLED=false
# GEMINI_ENABLED=true
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Option 3: OpenAI - paid - see https://platform.openai.com ---
# OLLAMA_ENABLED=false
# OPENAI_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small