    {
      "name": "Chat — Validation",
      "item": [
        {
          "name": "Empty message → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Has status field\", () => pm.expect(pm.response.json().status).to.equal(400));",
                  "pm.test(\"Has message field\", () => pm.expect(pm.response.json().message).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Off-domain question → refused",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"Give me a pizza recipe\", \"model\": \"fast\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Answer is refusal\", () => {",
                  "    const answer = pm.response.json().answer.toLowerCase();",
                  "    pm.expect(answer).to.satisfy(a =>",
                  "        a.includes('only') || a.includes('running') || a.includes('cannot') || a.includes('sorry') || a.includes('apologize')",
                  "    );",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
