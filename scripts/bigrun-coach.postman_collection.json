{
  "info": {
    "name": "BigRun Coach API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "Config",
      "item": [
        {
          "name": "GET active config",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/config"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has provider\", () => pm.expect(pm.response.json().provider).to.be.a('string').and.not.empty);",
                  "pm.test(\"Has smartModel\", () => pm.expect(pm.response.json().smartModel).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat — Tool Calling",
      "item": [
        {
          "name": "Pace for marathon 3h",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"message\": \"Pace for 3h marathon?\", \"model\": \"smart\"}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has answer\", () => pm.expect(pm.response.json().answer).to.be.a('string').and.not.empty);",
                  "pm.test(\"Response time < 60s\", () => pm.expect(pm.response.responseTime).to.be.below(60000));"
                ]
              }
            }
          ]
        },
